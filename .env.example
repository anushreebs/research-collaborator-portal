# Local: defaults work without this file. Load explicitly with Node --env-file.
# Production: set these in the hosting service's secret settings.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
SESSION_SECRET=
ADMIN_DEMO_PASSWORD=
RESEARCHER_DEMO_PASSWORD=
WEB_ORIGIN=https://YOUR-SERVICE.onrender.com
# Set true only after HTTPS redirect/proxy behavior is verified at the deployed domain.
ENABLE_HSTS=false
# Same-origin deployments omit API_ORIGIN. Split API deployments set this exact API HTTPS origin.
# API_ORIGIN=https://YOUR-API.example.com
# Optional server-side integrations:
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCOUNT_ID=
QUICKSIGHT_USER_ARN=
QUICKSIGHT_DASHBOARD_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
# Same-origin hosting leaves this unset. For separate hosting set at build time:
# VITE_API_URL=https://YOUR-API.example.com
