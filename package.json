{
  "name": "research-collaborator-portal",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:api && npm run test:unit",
    "test:api": "NODE_ENV=test node --import tsx --test server/*.test.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome lint src server scripts vite.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dev:api": "node --watch --import tsx server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node --import tsx server/index.ts",
    "export:synthetic": "NODE_ENV=test node --import tsx scripts/export-synthetic.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-quicksight": "^3.1142.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^6.1.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.1",
    "lucide-react": "^1.48.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
